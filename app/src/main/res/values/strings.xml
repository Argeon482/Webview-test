    <!-- Guided Wizard Titles, Buttons, and Plain-English Instructions -->
    <string name="wizard_step_1_title">Step 1 — Find Game Engine</string>
    <string name="step_1_inspect_scope">1. Scan Custom Globals</string>
    <string name="wizard_step_1_instruction">Load the web app and log in until your character is visible on screen, then tap \'1. Scan Custom Globals\'. Discovered globals accumulate in the Staging tab.</string>

    <string name="wizard_step_2_title">Step 2 — Lock On to Live Player Coordinates</string>
    <string name="step_2a_capture_baseline">2A. Capture Standing Baseline</string>
    <string name="wizard_step_2a_instruction">Stand completely still in-game and tap \'2A. Capture Standing Baseline\'.</string>
    <string name="step_2b_compute_delta">2B. Isolate Player Coords</string>
    <string name="wizard_step_2b_instruction">Walk your character 5–10 steps in any direction, stop, and tap \'2B. Isolate Player Coords\' to start 200ms live reference polling.</string>

    <string name="wizard_step_3_title">Step 3 — Visual Entity Inspection</string>
    <string name="step_3_scan_entities">3. Scan Nearby Entities</string>
    <string name="wizard_step_3_instruction">Make sure 2+ monsters or entities are visible on your screen, then tap \'3. Scan Nearby Entities\' (anchored to Step 2B\'s player parent container).</string>

    <string name="wizard_step_4_title">Step 4 — Export Handoff Report</string>
    <string name="step_4_export_report">4. Export Report (.json)</string>
    <string name="wizard_step_4_instruction">Once Steps 2B and 3 show [CAPTURED ✓] (and any candidates are pinned in Staging), tap \'4. Export Report (.json)\' to save to Downloads.</string>

